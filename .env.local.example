NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix this with NEXT_PUBLIC_, or it ships to the
# browser. From Supabase dashboard → Project Settings → API → service_role
# key. Used only by app/api/account/delete/route.ts to permanently delete
# a user's own account via the Supabase admin API.
SUPABASE_SERVICE_ROLE_KEY=
